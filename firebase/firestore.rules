rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') != 'deleting';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userDoc().data.role == 'admin' || userDoc().data.role == 'owner');
    }

    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    match /listingCategories/{categoryId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if false;
    }

    match /promotionPlans/{planId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if false;
    }

    match /bannerPlans/{planId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if false;
    }

    match /locations/{locationId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if false;
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || isOwner(resource.data.ownerId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /listingDrafts/{draftId} {
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /listingFavorites/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /bannerAds/{bannerId} {
      allow read: if resource.data.status == 'active' || isOwner(resource.data.ownerId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /chatRooms/{chatId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow update: if false;
      allow create: if false;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (signedIn()
            && resource.data.status != 'blocked'
            && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(chatId)).data.participants);
        allow create: if false;
        allow update, delete: if false;
      }
    }

    match /moderationCases/{caseId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId) || isOwner(resource.data.reporterId);
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || isOwner(resource.data.reporterId);
      allow create, update, delete: if false;
    }

    match /savedSearches/{searchId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /listingStats/{listingId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /ownerAuditLog/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /wappiOtpRequests/{requestId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
